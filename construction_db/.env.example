# Copy to .env and replace every placeholder. .env is git-ignored; never commit it.

# Postgres (docker compose db service)
POSTGRES_USER=siteproof
POSTGRES_PASSWORD=change-me
POSTGRES_DB=siteproof

# Only for "go run ./cmd/api"; docker compose builds its own from the values above.
DATABASE_URL=postgres://siteproof:change-me@localhost:5433/siteproof?sslmode=disable

# API
PORT=8080
# 32 or more random characters.
JWT_SECRET=change-me-to-at-least-32-random-characters

# Evidence storage. Locally this is MinIO; the access key and secret are also
# its login (the secret needs 8+ characters). Leave both empty on AWS to use
# the default credential chain.
S3_BUCKET=evidence
S3_REGION=af-south-1
S3_ACCESS_KEY_ID=siteproof
S3_SECRET_ACCESS_KEY=change-me-too
# For "go run". docker compose points the API at minio:9000 itself.
S3_ENDPOINT=http://localhost:9000
# The host clients upload to. For a real phone, use this machine's LAN
# address, e.g. http://192.168.1.20:9000.
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Must match the bucket's default retention: GOVERNANCE locally,
# production's mode is decided at DEPLOY.
EVIDENCE_LOCK_MODE=GOVERNANCE
