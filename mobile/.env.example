# Where the Go API is running. Unlike the dashboard, the phone calls the API
# directly, so this address must be reachable from the phone:
#   Android emulator   http://10.0.2.2:8080
#   iOS simulator      http://localhost:8080
#   A real phone       http://<your PC's Wi-Fi address>:8080  (run `ipconfig`)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
